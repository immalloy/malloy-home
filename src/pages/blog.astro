---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";

return new Response(null, { status: 404 });

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const recentCutoff = Date.now() - 3 * 24 * 60 * 60 * 1000;
const featuredPostId = posts[0]?.data.date.getTime() >= recentCutoff ? posts[0].id : null;
---

<SiteLayout
  title="Blog | ImMalloy"
  description="Project updates, drawing thoughts, and notes from Malloy."
>
  <main class="blog-page" aria-labelledby="blog-title">
    <header class="blog-heading">
      <h1 id="blog-title">Blog</h1>
    </header>

    {posts.length > 0 ? (
      <div class="blog-list">
        {posts.map((post) => (
          <a
            class={post.id === featuredPostId ? "blog-post blog-post-featured" : "blog-post"}
            href={`/blog/${post.id}`}
          >
            <img class="blog-post-image" src={post.data.image} alt={post.data.imageAlt} loading="lazy" />
            {post.id === featuredPostId && <span class="blog-post-badge">Latest</span>}
            <div class="blog-post-copy">
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              <time class="blog-post-date" datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                  timeZone: "UTC",
                })}
              </time>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="blog-empty">No notes yet. I’m still making something worth writing about.</p>
    )}
  </main>
</SiteLayout>

<style>
  @font-face {
    font-family: "FunkinOptions";
    src: url("/fonts/FunkinOptions.otf") format("opentype");
    font-display: swap;
  }

  @font-face {
    font-family: "FunkinLingLong";
    src: url("/fonts/FunkinLingLong.otf") format("opentype");
    font-display: swap;
  }

  .blog-page {
    max-width: 76rem;
    min-height: 100svh;
    margin: 0 auto;
    padding: clamp(3rem, 7vw, 6rem) clamp(1.25rem, 4vw, 3rem) 6rem;
  }

  .blog-heading {
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }

  h1,
  h2 {
    margin: 0;
    color: var(--site-accent);
    font-family: "FunkinOptions", sans-serif;
    font-weight: 400;
  }

  h1 {
    font-size: clamp(4rem, 10vw, 8rem);
    letter-spacing: -0.04em;
    line-height: 0.82;
    text-align: center;
  }

  :global(html[data-theme="dark"]) .blog-heading h1 {
    filter: drop-shadow(2px 0 var(--site-foreground)) drop-shadow(-2px 0 var(--site-foreground)) drop-shadow(0 2px var(--site-foreground)) drop-shadow(0 -2px var(--site-foreground)) drop-shadow(1px 1px var(--site-foreground)) drop-shadow(-1px 1px var(--site-foreground)) drop-shadow(1px -1px var(--site-foreground)) drop-shadow(-1px -1px var(--site-foreground));
  }

  .blog-list {
    display: grid;
    gap: 1rem;
  }

  .blog-post {
    position: relative;
    display: block;
    min-height: clamp(13rem, 24vw, 18rem);
    padding: clamp(1.25rem, 3vw, 2rem);
    border-inline-start: 4px solid var(--site-accent);
    background: color-mix(in srgb, var(--site-foreground) 4%, var(--site-background));
    color: inherit;
    overflow: hidden;
    text-decoration: none;
    transition: background-color 180ms ease, transform 180ms ease;
  }

  .blog-post-featured {
    background: color-mix(in srgb, var(--site-accent) 10%, var(--site-background));
  }

  .blog-post:not(.blog-post-featured) {
    border-inline-start-color: color-mix(in srgb, var(--site-foreground) 24%, transparent);
    background: color-mix(in srgb, var(--site-foreground) 3%, var(--site-background));
  }

  .blog-post-copy {
    position: relative;
    z-index: 1;
    padding-inline-end: clamp(8rem, 48%, 30rem);
  }

  .blog-post-image {
    position: absolute;
    z-index: 0;
    inset-block: 0;
    inset-inline-end: 0;
    width: 58%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    clip-path: polygon(30% 0, 100% 0, 100% 100%, 0 100%);
    pointer-events: none;
  }

  .blog-post-badge {
    position: absolute;
    inset-block-start: clamp(1.25rem, 3vw, 2rem);
    inset-inline-end: clamp(1.25rem, 3vw, 2rem);
    padding: 0.35rem 0.55rem;
    background: var(--site-accent);
    color: var(--site-background);
    font-family: "FunkinOptions", sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .blog-post:hover,
  .blog-post:focus-visible {
    background: color-mix(in srgb, var(--site-accent) 16%, var(--site-background));
    transform: translateX(0.25rem);
  }

  .blog-post-featured:hover,
  .blog-post-featured:focus-visible {
    background: color-mix(in srgb, var(--site-accent) 23%, var(--site-background));
  }

  .blog-post:not(.blog-post-featured):hover,
  .blog-post:not(.blog-post-featured):focus-visible {
    background: color-mix(in srgb, var(--site-foreground) 8%, var(--site-background));
  }

  .blog-post:focus-visible {
    outline: 2px solid var(--site-accent);
    outline-offset: 0.35rem;
  }

  .blog-post-date {
    display: block;
    margin-top: 1.25rem;
    color: color-mix(in srgb, var(--site-foreground) 68%, var(--site-background));
    font-family: "FunkinOptions", sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  h2 {
    font-size: clamp(2rem, 5vw, 4rem);
    letter-spacing: -0.03em;
    line-height: 0.9;
  }

  .blog-post p {
    max-width: 46rem;
    margin: 0.9rem 0 0;
    font-size: 1.1rem;
    line-height: 1.45;
  }

  .blog-empty {
    max-width: 36rem;
    color: var(--site-muted-strong);
    font-size: 1.2rem;
  }

  @media (max-width: 600px) {
    .blog-page {
      padding-top: 2.5rem;
      padding-bottom: 4rem;
    }

    .blog-post {
      display: block;
    }

    .blog-post-copy {
      padding-inline-end: 48%;
    }
  }
</style>
