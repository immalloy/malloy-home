---
import SiteLayout from "../layouts/SiteLayout.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
---

<SiteLayout title="About Me | ImMalloy" description="About ImMalloy.">
  <ThemeToggle />

  <main class="unfinished" aria-labelledby="unfinished-title">
    <p class="eyebrow">About me</p>
    <h1 id="unfinished-title">Not finished yet.</h1>
    <a href="/">Back home</a>
  </main>
</SiteLayout>

<style>
  @font-face {
    font-family: "FunkinOptions";
    src: url("/fonts/FunkinOptions.otf") format("opentype");
    font-display: swap;
  }

  .unfinished {
    display: grid;
    min-height: 100svh;
    place-content: center;
    gap: 1.25rem;
    padding: 2rem;
    text-align: center;
  }

  .eyebrow {
    margin: 0;
    color: var(--site-muted);
    font-family: "FunkinOptions", sans-serif;
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 28rem;
    margin: 0;
    color: var(--site-accent);
    font-family: "FunkinOptions", sans-serif;
    font-size: clamp(3rem, 10vw, 7rem);
    font-weight: 400;
    line-height: 0.85;
  }

  a {
    justify-self: center;
    color: var(--site-accent);
    font-family: "FunkinOptions", sans-serif;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
  }

  a:hover,
  a:focus-visible {
    color: var(--site-foreground);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  a:focus-visible {
    outline: 2px solid var(--site-accent);
    outline-offset: 0.35rem;
  }
</style>
