---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { requireGuestbookAdmin } from "../../lib/guestbook-admin";

const authError = requireGuestbookAdmin(Astro.request);
const authenticated = !authError;

if (authError) {
  Astro.response.status = authError.status;
  authError.headers.forEach((value, key) => Astro.response.headers.set(key, value));
  Astro.response.headers.set("Content-Type", "text/html; charset=utf-8");
}
---

<SiteLayout title="Guestbook moderation | ImMalloy" description="Private guestbook moderation." noIndex>
  {authenticated ? (
    <main class="moderation-page" aria-labelledby="moderation-title">
      <div class="moderation-heading">
        <h1 id="moderation-title">Guestbook moderation</h1>
        <a class="back-link" href="/guestbook">Back to guestbook</a>
      </div>

      <div class="moderation-toolbar">
        <p data-admin-status role="status" aria-live="polite">Loading entries...</p>
        <button class="action-button" type="button" data-refresh>Refresh</button>
      </div>

      <form class="moderation-filters" data-admin-filters aria-label="Filter guestbook entries">
        <label class="filter-field filter-search">
          <span>Search</span>
          <input type="search" data-filter-search placeholder="Name, message, country..." />
        </label>
        <label class="filter-field">
          <span>Status</span>
          <select data-filter-status>
            <option value="all">All statuses</option>
            <option value="pending">Pending</option>
            <option value="approved">Approved</option>
            <option value="rejected">Rejected</option>
          </select>
        </label>
        <label class="filter-field">
          <span>Content</span>
          <select data-filter-content>
            <option value="all">All entries</option>
            <option value="message">With message</option>
            <option value="drawing">With drawing</option>
          </select>
        </label>
        <button class="filter-clear" type="reset">Clear filters</button>
      </form>

      <section aria-labelledby="entries-title">
        <h2 id="entries-title" class="visually-hidden">Guestbook entries</h2>
        <div class="moderation-list" data-admin-list></div>
      </section>
    </main>
  ) : (
    <main class="moderation-page moderation-locked" aria-labelledby="moderation-locked-title">
      <h1 id="moderation-locked-title">Guestbook moderation</h1>
      <p>Authentication is required to open this page.</p>
    </main>
  )}
</SiteLayout>

{authenticated && (
  <script>
    type AdminEntry = {
      id: string;
      name: string;
      message: string;
      country: string;
      hasDrawing: boolean;
      status: "pending" | "approved" | "rejected";
      createdAt: string;
    };

    const list = document.querySelector("[data-admin-list]");
    const status = document.querySelector("[data-admin-status]");
    const refreshButton = document.querySelector("[data-refresh]");
    const filters = document.querySelector("[data-admin-filters]");
    const searchInput = document.querySelector("[data-filter-search]");
    const statusFilter = document.querySelector("[data-filter-status]");
    const contentFilter = document.querySelector("[data-filter-content]");
    let allEntries: AdminEntry[] = [];

    const makeText = (tag: keyof HTMLElementTagNameMap, className: string, value: string) => {
      const element = document.createElement(tag);
      element.className = className;
      element.textContent = value;
      return element;
    };

    const formatDate = (value: string) => {
      const date = new Date(`${value.replace(" ", "T")}Z`);
      return Number.isNaN(date.getTime()) ? value : date.toLocaleString();
    };

    const setStatus = (message: string, error = false) => {
      if (status) {
        status.textContent = message;
        status.dataset.state = error ? "error" : "";
      }
    };

    const runAction = async (id: string, action: string) => {
      const response = await fetch("/api/guestbook-admin", {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({ id, action }),
      });
      const payload = await response.json();
      if (!response.ok) throw new Error(payload.error || "Could not update the entry.");
    };

    const renderEntries = (entries: AdminEntry[]) => {
      if (!list) return;
      list.replaceChildren();

      if (!entries.length) {
        list.append(makeText(
          "p",
          "empty-state",
          allEntries.length ? "No entries match these filters." : "There are no guestbook entries yet.",
        ));
        return;
      }

      for (const entry of entries) {
        const article = document.createElement("article");
        article.className = `moderation-entry moderation-entry-${entry.status}`;

        const header = document.createElement("header");
        header.className = "entry-header";
        header.append(
          makeText("h3", "entry-name", entry.name || "Anonymous"),
          makeText("p", "entry-meta", `${entry.country || "Country hidden"} / ${formatDate(entry.createdAt)}`),
          makeText("span", "entry-status", entry.status),
        );
        article.append(header);

        if (entry.message) article.append(makeText("p", "entry-message", entry.message));
        if (entry.hasDrawing) {
          const drawing = document.createElement("img");
          drawing.className = "entry-drawing";
          drawing.src = `/api/guestbook-drawing?id=${encodeURIComponent(entry.id)}&admin=1`;
          drawing.alt = `Drawing submitted by ${entry.name || "Anonymous"}`;
          drawing.loading = "lazy";
          article.append(drawing);
        }

        const actions = document.createElement("div");
        actions.className = "entry-actions";
        const actionLabels: Record<string, string> = {
          approved: "Approve",
          rejected: "Reject",
          pending: "Set pending",
          delete: "Delete",
        };
        for (const action of ["approved", "rejected", "pending", "delete"]) {
          if (action === entry.status) continue;
          const button = document.createElement("button");
          button.type = "button";
          button.className = action === "delete" ? "action-button action-button-danger" : "action-button";
          button.dataset.entryAction = action;
          button.dataset.entryId = entry.id;
          button.textContent = actionLabels[action];
          actions.append(button);
        }
        article.append(actions);
        list.append(article);
      }
    };

    const getFilteredEntries = () => {
      const query = searchInput instanceof HTMLInputElement ? searchInput.value.trim().toLowerCase() : "";
      const selectedStatus = statusFilter instanceof HTMLSelectElement ? statusFilter.value : "all";
      const selectedContent = contentFilter instanceof HTMLSelectElement ? contentFilter.value : "all";

      return allEntries.filter((entry) => {
        if (selectedStatus !== "all" && entry.status !== selectedStatus) return false;
        if (selectedContent === "message" && !entry.message) return false;
        if (selectedContent === "drawing" && !entry.hasDrawing) return false;
        if (!query) return true;

        return [entry.name, entry.message, entry.country, entry.status]
          .some((value) => value.toLowerCase().includes(query));
      });
    };

    const renderFilteredEntries = () => {
      const filteredEntries = getFilteredEntries();
      renderEntries(filteredEntries);
      if (allEntries.length !== filteredEntries.length) {
        setStatus(`Showing ${filteredEntries.length} of ${allEntries.length} entries.`);
      } else {
        setStatus(`${allEntries.length} entr${allEntries.length === 1 ? "y" : "ies"} loaded.`);
      }
    };

    const loadEntries = async () => {
      if (refreshButton instanceof HTMLButtonElement) refreshButton.disabled = true;
      setStatus("Loading entries...");

      try {
        const response = await fetch("/api/guestbook-admin", { headers: { Accept: "application/json" } });
        const payload = await response.json();
        if (!response.ok) throw new Error(payload.error || "Could not load entries.");
        allEntries = Array.isArray(payload.entries) ? payload.entries as AdminEntry[] : [];
        renderFilteredEntries();
      } catch (error) {
        setStatus(error instanceof Error ? error.message : "Could not load entries.", true);
      } finally {
        if (refreshButton instanceof HTMLButtonElement) refreshButton.disabled = false;
      }
    };

    refreshButton?.addEventListener("click", loadEntries);
    filters?.addEventListener("submit", (event) => event.preventDefault());
    filters?.addEventListener("input", renderFilteredEntries);
    filters?.addEventListener("change", renderFilteredEntries);
    filters?.addEventListener("reset", () => window.setTimeout(renderFilteredEntries));
    list?.addEventListener("click", async (event) => {
      const target = event.target;
      if (!(target instanceof HTMLButtonElement)) return;
      const id = target.dataset.entryId;
      const action = target.dataset.entryAction;
      if (!id || !action) return;
      if (action === "delete" && !window.confirm("Delete this entry permanently?")) return;

      const buttons = list.querySelectorAll("button");
      buttons.forEach((button) => { button.disabled = true; });
      setStatus("Updating entry...");
      try {
        await runAction(id, action);
        await loadEntries();
      } catch (error) {
        setStatus(error instanceof Error ? error.message : "Could not update the entry.", true);
        buttons.forEach((button) => { button.disabled = false; });
      }
    });

    loadEntries();
  </script>
)}

<style>
  @font-face {
    font-family: "FunkinOptions";
    src: url("/fonts/FunkinOptions.otf") format("opentype");
    font-display: swap;
  }

  @font-face {
    font-family: "FunkinLingLong";
    src: url("/fonts/FunkinLingLong.otf") format("opentype");
    font-display: swap;
  }

  .moderation-page {
    max-width: 76rem;
    min-height: 100svh;
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 4rem) clamp(1.25rem, 4vw, 4rem) 6rem;
  }

  .moderation-heading,
  .moderation-toolbar,
  :global(.entry-header),
  :global(.entry-actions) {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .moderation-heading {
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 1rem;
    color: var(--site-accent);
    font-family: "FunkinOptions", sans-serif;
    font-size: clamp(2.75rem, 7vw, 6rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 0.9;
    text-wrap: balance;
  }

  .moderation-heading h1 {
    margin-bottom: 0;
  }

  .moderation-locked p {
    max-width: 38rem;
    margin-bottom: 0;
    color: var(--site-muted-strong);
    font-family: "FunkinLingLong", sans-serif;
    font-size: 1.15rem;
    line-height: 1.35;
  }

  .back-link,
  :global(.action-button) {
    border: 2px solid var(--site-accent);
    padding: 0.75rem 1rem;
    background: transparent;
    color: var(--site-accent);
    cursor: pointer;
    font-family: "FunkinOptions", sans-serif;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .back-link:hover,
  .back-link:focus-visible,
  :global(.action-button:hover:not(:disabled)),
  :global(.action-button:focus-visible:not(:disabled)) {
    background: var(--site-accent);
    color: var(--site-background);
    transform: translateY(-0.15rem);
  }

  .back-link:focus-visible,
  :global(.action-button:focus-visible) {
    outline: 2px solid var(--site-foreground);
    outline-offset: 0.35rem;
  }

  .moderation-toolbar {
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  [data-admin-status] {
    min-height: 1.3em;
    margin: 0;
    color: var(--site-muted-strong);
    font-family: "FunkinLingLong", sans-serif;
  }

  [data-admin-status][data-state="error"] {
    color: #d64264;
  }

  .moderation-filters {
    display: grid;
    grid-template-columns: minmax(14rem, 2fr) repeat(2, minmax(9rem, 1fr)) auto;
    align-items: end;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .filter-field {
    display: grid;
    gap: 0.35rem;
    color: var(--site-muted-strong);
    font-family: "FunkinOptions", sans-serif;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .filter-field input,
  .filter-field select {
    min-width: 0;
    border: 1px solid color-mix(in srgb, var(--site-foreground) 22%, transparent);
    padding: 0.65rem 0.7rem;
    background: color-mix(in srgb, var(--site-foreground) 5%, var(--site-background));
    color: var(--site-foreground);
    font: 0.95rem "FunkinLingLong", sans-serif;
  }

  .filter-field input:focus-visible,
  .filter-field select:focus-visible {
    outline: 2px solid var(--site-accent);
    outline-offset: 2px;
  }

  .filter-clear {
    border: 0;
    padding: 0.65rem 0.25rem;
    background: transparent;
    color: var(--site-muted-strong);
    cursor: pointer;
    font: 0.68rem "FunkinOptions", sans-serif;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .filter-clear:hover,
  .filter-clear:focus-visible {
    color: var(--site-accent);
  }

  .filter-clear:focus-visible {
    outline: 2px solid var(--site-accent);
    outline-offset: 2px;
  }

  .moderation-list {
    column-count: 4;
    column-gap: 0.75rem;
  }

  :global(.moderation-entry) {
    min-width: 0;
    break-inside: avoid;
    margin-bottom: 0.75rem;
    padding: 0.85rem;
    background: color-mix(in srgb, var(--site-accent) 8%, var(--site-background));
    box-shadow: 0 0.35rem 1rem color-mix(in srgb, var(--site-foreground) 10%, transparent);
  }

  :global(.moderation-entry-pending) {
    background: color-mix(in srgb, #f0b84b 13%, var(--site-background));
  }

  :global(.moderation-entry-rejected) {
    background: color-mix(in srgb, #d64264 10%, var(--site-background));
  }

  :global(.entry-header) {
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.65rem;
    margin-bottom: 0.7rem;
  }

  :global(.entry-name) {
    margin-bottom: 0;
    color: var(--site-foreground);
    font-family: "FunkinOptions", sans-serif;
    font-size: 1rem;
    font-weight: 400;
  }

  :global(.entry-meta),
  :global(.entry-status) {
    margin-bottom: 0;
    color: var(--site-muted-strong);
    font-family: "FunkinLingLong", sans-serif;
    font-size: 0.78rem;
  }

  :global(.entry-status) {
    margin-inline-start: auto;
    color: var(--site-accent);
    font-family: "FunkinOptions", sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  :global(.entry-message) {
    max-height: 6rem;
    margin-bottom: 0.75rem;
    overflow-y: auto;
    font-size: 0.9rem;
    line-height: 1.25;
    white-space: pre-wrap;
  }

  :global(.entry-drawing) {
    display: block;
    width: 100%;
    max-width: 100%;
    height: 6rem;
    margin-bottom: 0.75rem;
    object-fit: contain;
    object-position: center;
    background: #fffdf6;
    outline: 1px solid color-mix(in srgb, var(--site-foreground) 16%, transparent);
  }

  :global(.entry-actions) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.45rem;
  }

  :global(.entry-actions .action-button) {
    min-width: 0;
    padding: 0.5rem 0.35rem;
    font-size: 0.62rem;
    letter-spacing: 0.04em;
  }

  :global(.entry-actions .action-button-danger) {
    border-color: #d64264;
    color: #d64264;
  }

  :global(.entry-actions .action-button-danger:hover:not(:disabled)),
  :global(.entry-actions .action-button-danger:focus-visible:not(:disabled)) {
    background: #d64264;
    color: #fffdf6;
  }

  :global(.action-button:disabled) {
    cursor: wait;
    opacity: 0.5;
  }

  :global(.empty-state) {
    column-span: all;
    margin: 2rem 0;
    color: var(--site-muted-strong);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 40rem) {
    .moderation-heading {
      display: grid;
      gap: 1.5rem;
    }

    .back-link {
      justify-self: start;
    }

    .moderation-toolbar {
      align-items: flex-start;
    }

    .moderation-filters {
      grid-template-columns: 1fr 1fr;
    }

    .filter-search,
    .filter-clear {
      grid-column: 1 / -1;
    }

    :global(.entry-status) {
      width: 100%;
      margin-inline-start: 0;
    }
  }

  @media (min-width: 40.01rem) and (max-width: 64rem) {
    .moderation-list {
      column-count: 3;
    }
  }

  @media (min-width: 40.01rem) and (max-width: 50rem) {
    .moderation-filters {
      grid-template-columns: 1fr 1fr;
    }

    .filter-search {
      grid-column: 1 / -1;
    }

    .filter-clear {
      justify-self: start;
    }
  }

  @media (max-width: 30rem) {
    .moderation-filters {
      grid-template-columns: 1fr;
    }

    .moderation-list {
      column-count: 1;
    }

    .filter-search,
    .filter-clear {
      grid-column: auto;
    }

    .filter-clear {
      justify-self: start;
    }
  }

</style>
