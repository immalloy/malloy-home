---
import SiteLayout from "../layouts/SiteLayout.astro";
import { getLocale, localizedPath, tx } from "../lib/i18n";

const locale = getLocale(Astro.props.locale ?? Astro.currentLocale);
---

<SiteLayout
  title="ImMalloy"
  description={tx(locale, "Welcome to my website!", "¡Bienvenido a mi sitio web!")}
  locale={locale}
>
  <main class="swiper" aria-label={tx(locale, "Site sections", "Secciones del sitio")}>
      <div class="swiper-wrapper">
        <section class="swiper-slide hero" aria-labelledby="site-title">
          <div class="hero-content">
            <h1 id="site-title">ImMalloy</h1>
            <p>{tx(locale, "Welcome to my website!", "¡Bienvenido a mi sitio web!")}</p>
          </div>

          <nav class="slide-navigation slide-navigation-down" aria-label={tx(locale, "Section navigation", "Navegación de secciones")}>
            <button class="slide-arrow scroll-cue slide-arrow-down" type="button" aria-label={tx(locale, "Scroll to more content", "Desliza para ver más contenido")} data-slide-direction="next">
              <span>{tx(locale, "Scroll to explore", "Desliza para explorar")}</span>
              <img class="slide-arrow-icon" src="/assets/ui/down-arrow.webp" alt="" aria-hidden="true" />
            </button>
          </nav>
        </section>

        <section class="swiper-slide about-preview" aria-labelledby="about-preview-title">
          <div class="about-illustration">
            <img src="/assets/home/memstar-hello.webp" alt={tx(locale, "Memstar waving hello.", "Memstar saludando.")} />
          </div>

          <div class="about-preview-content">
            <h2 id="about-preview-title">{tx(locale, "Who am I?", "¿Quién soy?")}</h2>
            <p>
              {tx(locale, "I'm Malloy. I like coding, drawing, listening to music, and making cool projects! I'm always thinking of something new!", "Soy Malloy. ¡Me gusta programar, dibujar, escuchar música y crear proyectos geniales! Siempre estoy pensando en algo nuevo.")}
            </p>
            <a class="about-link" href={localizedPath(locale, "/about")}>{tx(locale, "About Me", "Sobre mí")}</a>
          </div>

          <nav class="slide-navigation" aria-label={tx(locale, "Section navigation", "Navegación de secciones")}>
            <button class="slide-arrow slide-arrow-up" type="button" aria-label={tx(locale, "Previous section", "Sección anterior")} data-slide-direction="prev">
              <img class="slide-arrow-icon" src="/assets/ui/down-arrow.webp" alt="" aria-hidden="true" />
            </button>
            <button class="slide-arrow slide-arrow-down" type="button" aria-label={tx(locale, "Next section", "Siguiente sección")} data-slide-direction="next">
              <img class="slide-arrow-icon" src="/assets/ui/down-arrow.webp" alt="" aria-hidden="true" />
            </button>
          </nav>
        </section>

        <section class="swiper-slide explore-preview" aria-labelledby="explore-preview-title">
          <div class="explore-illustration">
            <img src="/assets/home/inkandcatexplore.webp" alt={tx(locale, "Ink and Cat exploring together.", "Ink y Cat explorando juntos.")} />
          </div>

          <div class="explore-content">
            <h2 id="explore-preview-title">{tx(locale, "Explore", "Explora")}</h2>
            <p>{tx(locale, "Curious? Open the picker on the right and explore the rest of the site.", "\u00bfTienes curiosidad? Abre el selector de la derecha y explora el resto del sitio.")}</p>
            <button class="about-link explore-picker-button" type="button">{tx(locale, "Open picker", "Abrir selector")}</button>
          </div>

          <nav class="slide-navigation" aria-label={tx(locale, "Section navigation", "Navegación de secciones")}>
            <button class="slide-arrow slide-arrow-up" type="button" aria-label={tx(locale, "Previous section", "Sección anterior")} data-slide-direction="prev">
              <img class="slide-arrow-icon" src="/assets/ui/down-arrow.webp" alt="" aria-hidden="true" />
            </button>
            <button class="slide-arrow slide-arrow-down" type="button" aria-label={tx(locale, "Next section", "Siguiente sección")} data-slide-direction="next">
              <img class="slide-arrow-icon" src="/assets/ui/down-arrow.webp" alt="" aria-hidden="true" />
            </button>
          </nav>
        </section>

        <section class="swiper-slide support-preview" aria-labelledby="support-preview-title">
          <div class="support-illustration">
            <img src="/assets/home/b01andbumyxdonate.webp" alt={tx(locale, "B01 and Bumyx supporting the site.", "B01 y Bumyx apoyando el sitio.")} />
          </div>

          <div class="support-content">
            <h2 id="support-preview-title">{tx(locale, "Support my work", "Apoya mi trabajo")}</h2>
            <p>{tx(locale, "Like what I make? A small Ko-fi tip helps me keep building this site and new projects.", "\u00bfTe gusta lo que hago? Una peque\u00f1a propina en Ko-fi me ayuda a seguir construyendo este sitio y nuevos proyectos.")}</p>
            <a class="about-link" href="https://ko-fi.com/immalloy" target="_blank" rel="noreferrer">{tx(locale, "Support me on Ko-fi", "Ap\u00f3yame en Ko-fi")}</a>
          </div>

          <nav class="slide-navigation" aria-label={tx(locale, "Section navigation", "Navegaci\u00f3n de secciones")}>
            <button class="slide-arrow slide-arrow-up" type="button" aria-label={tx(locale, "Previous section", "Secci\u00f3n anterior")} data-slide-direction="prev">
              <img class="slide-arrow-icon" src="/assets/ui/down-arrow.webp" alt="" aria-hidden="true" />
            </button>
            <button class="slide-arrow slide-arrow-down" type="button" aria-label={tx(locale, "Next section", "Siguiente secci\u00f3n")} data-slide-direction="next">
              <img class="slide-arrow-icon" src="/assets/ui/down-arrow.webp" alt="" aria-hidden="true" />
            </button>
          </nav>
        </section>

        <footer class="swiper-slide site-footer" aria-labelledby="site-footer-title">
          <div class="site-footer-content">
            <div class="site-footer-lineup" aria-hidden="true"></div>
            <h2 id="site-footer-title">IMMALLOY</h2>
            <nav class="site-footer-links" aria-label={tx(locale, "Footer links", "Enlaces del pie de p\u00e1gina")}>
              <a href={localizedPath(locale, "/")}>{tx(locale, "Home", "Inicio")}</a>
              <a href={localizedPath(locale, "/about")}>{tx(locale, "About", "Sobre m\u00ed")}</a>
              <a href={localizedPath(locale, "/comics")}>Comics</a>
              <a href={localizedPath(locale, "/guestbook")}>{tx(locale, "Guestbook", "Libro de visitas")}</a>
              <a href="https://ko-fi.com/immalloy" target="_blank" rel="noreferrer">{tx(locale, "Support me on Ko-fi", "Ap\u00f3yame en Ko-fi")}</a>
            </nav>
            <p class="site-footer-note">© ImMalloy · Honduras</p>
          </div>

          <nav class="slide-navigation slide-navigation-up" aria-label={tx(locale, "Section navigation", "Navegaci\u00f3n de secciones")}>
            <button class="slide-arrow slide-arrow-up" type="button" aria-label={tx(locale, "Previous section", "Secci\u00f3n anterior")} data-slide-direction="prev">
              <img class="slide-arrow-icon" src="/assets/ui/down-arrow.webp" alt="" aria-hidden="true" />
            </button>
          </nav>
        </footer>
      </div>
      <span class="explore-picker-hint" aria-hidden="true">
        <img src="/assets/ui/down-arrow.webp" alt="" />
      </span>
  </main>
</SiteLayout>

<style>
  @font-face {
    font-family: "FunkinOptions";
    src: url("/fonts/FunkinOptions.otf") format("opentype");
    font-display: swap;
  }

  @font-face {
    font-family: "FunkinLingLong";
    src: url("/fonts/FunkinLingLong.otf") format("opentype");
    font-display: swap;
  }

  :global(html),
  :global(body) {
    height: 100%;
    overflow: hidden;
  }

  :global(body) {
    background: var(--site-background);
    color: var(--site-foreground);
  }

  .swiper {
    --swiper-wrapper-transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100svh;
    user-select: none;
  }

  .swiper img {
    -webkit-user-drag: none;
    user-select: none;
  }

  .swiper-slide {
    display: grid;
    min-height: 100vh;
    min-height: 100svh;
    padding: 2rem;
    place-items: center;
    position: relative;
  }

  .hero {
    display: grid;
    position: relative;
  }

  .hero-content {
    max-width: 70rem;
    text-align: center;
  }

  .about-preview,
  .explore-preview,
  .support-preview {
    grid-template-columns: minmax(0, 0.9fr) minmax(18rem, 0.75fr);
    gap: var(--site-feature-gap);
    max-width: 90rem;
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 5rem);
  }

  .about-illustration,
  .explore-illustration,
  .support-illustration {
    display: grid;
    min-height: var(--site-feature-visual-height);
    place-items: center;
  }

  .about-illustration img,
  .explore-illustration img,
  .support-illustration img {
    display: block;
    width: min(100%, 38rem);
    height: var(--site-feature-visual-height);
    object-fit: contain;
  }

  :global(html[data-theme="dark"]) .about-illustration img,
  :global(html[data-theme="dark"]) .explore-illustration img,
  :global(html[data-theme="dark"]) .support-illustration img {
    filter: drop-shadow(2px 0 var(--site-foreground)) drop-shadow(-2px 0 var(--site-foreground)) drop-shadow(0 2px var(--site-foreground)) drop-shadow(0 -2px var(--site-foreground)) drop-shadow(1px 1px var(--site-foreground)) drop-shadow(-1px 1px var(--site-foreground)) drop-shadow(1px -1px var(--site-foreground)) drop-shadow(-1px -1px var(--site-foreground));
  }

  :global(html[data-theme="dark"]) #site-title,
  :global(html[data-theme="dark"]) .about-preview h2,
  :global(html[data-theme="dark"]) .explore-preview h2,
  :global(html[data-theme="dark"]) .support-preview h2,
  :global(html[data-theme="dark"]) .site-footer h2 {
    filter: drop-shadow(2px 0 var(--site-foreground)) drop-shadow(-2px 0 var(--site-foreground)) drop-shadow(0 2px var(--site-foreground)) drop-shadow(0 -2px var(--site-foreground)) drop-shadow(1px 1px var(--site-foreground)) drop-shadow(-1px 1px var(--site-foreground)) drop-shadow(1px -1px var(--site-foreground)) drop-shadow(-1px -1px var(--site-foreground));
  }

  .about-preview-content,
  .explore-content,
  .support-content {
    max-width: 32rem;
  }

  .about-preview h2,
  .explore-preview h2,
  .support-preview h2 {
    margin: 0;
    color: var(--site-accent);
    font-family: "FunkinOptions", sans-serif;
    font-size: clamp(4rem, 9vw, 8rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 0.84;
    text-wrap: balance;
  }

  .about-preview-content p,
  .explore-content p,
  .support-content p {
    max-width: 28rem;
    margin: 2rem 0 2.5rem;
    font-size: clamp(1.25rem, 2.5vw, 2rem);
    line-height: 1.3;
    text-wrap: pretty;
  }

  .explore-picker-hint {
    position: absolute;
    z-index: 1;
    top: 50%;
    right: calc(var(--site-picker-width) + env(safe-area-inset-right) + 1rem);
    width: clamp(1.5rem, 3vw, 2.5rem);
    transform: translateY(-50%);
    animation: explore-picker-point 900ms ease-in-out infinite alternate;
    animation-play-state: paused;
    opacity: 0;
    pointer-events: none;
    transition: opacity 320ms ease;
  }

  .swiper:has(.explore-preview.swiper-slide-active) .explore-picker-hint {
    animation-play-state: running;
    opacity: 1;
  }

  .explore-picker-hint img {
    display: block;
    width: 100%;
    transform: rotate(-90deg);
    filter: brightness(0);
    opacity: 0.5;
  }

  :global(html[data-theme="dark"]) .explore-picker-hint img {
    filter: brightness(0) invert(1);
  }

  @keyframes explore-picker-point {
    from {
      transform: translate(-0.25rem, -50%);
    }

    to {
      transform: translate(0.35rem, -50%);
    }
  }

  .about-link {
    display: inline-block;
    border: 2px solid var(--site-accent);
    padding: 0.85rem 1.1rem;
    color: var(--site-accent);
    font-family: "FunkinOptions", sans-serif;
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .about-link:hover,
  .about-link:focus-visible {
    background: var(--site-accent);
    color: var(--site-background);
    transform: translateY(-0.15rem);
  }

  .about-link:focus-visible {
    outline: 2px solid var(--site-foreground);
    outline-offset: 0.4rem;
  }

  .explore-picker-button {
    appearance: none;
    background: none;
    cursor: pointer;
  }

  .slide-navigation {
    position: absolute;
    z-index: 2;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: max(1.5rem, env(safe-area-inset-top)) 1rem max(2rem, env(safe-area-inset-bottom));
    pointer-events: none;
  }

  .slide-navigation-down {
    justify-content: flex-end;
  }

  .slide-navigation-up {
    justify-content: flex-start;
  }

  .slide-arrow {
    border: 0;
    display: grid;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0.75rem;
    place-items: center;
    background: transparent;
    color: var(--site-muted-strong);
    cursor: pointer;
    pointer-events: auto;
    transition: color 180ms ease, opacity 180ms ease;
  }

  .slide-arrow:hover:not(:disabled),
  .slide-arrow:focus-visible:not(:disabled) {
    color: var(--site-foreground);
  }

  .slide-arrow:disabled {
    cursor: default;
    opacity: 0.25;
  }

  .slide-arrow:focus-visible {
    outline: 2px solid var(--site-accent);
    outline-offset: 0.4rem;
  }

  .slide-arrow-icon {
    display: block;
    width: clamp(0.6rem, 1.6vw, 1rem);
    height: auto;
    opacity: 0.65;
    filter: brightness(0) saturate(100%) invert(56%) sepia(96%) saturate(1493%) hue-rotate(196deg) brightness(101%) contrast(101%);
    transition: opacity 180ms ease;
  }

  .slide-arrow-up .slide-arrow-icon {
    transform: rotate(180deg);
  }

  .slide-arrow:hover:not(:disabled) .slide-arrow-icon,
  .slide-arrow:focus-visible:not(:disabled) .slide-arrow-icon {
    opacity: 1;
  }

  h1 {
    margin: 0;
    color: var(--site-accent);
    font-family: "FunkinOptions", sans-serif;
    font-size: clamp(5rem, 18vw, 14rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 0.82;
    text-wrap: balance;
  }

  .hero p {
    margin: 2rem 0 0;
    font-size: clamp(1.4rem, 3vw, 2.5rem);
    line-height: 1.2;
    text-wrap: balance;
  }

  .scroll-cue {
    border: 0;
    display: grid;
    gap: 0.5rem;
    padding: 0.75rem;
    background: transparent;
    color: var(--site-muted-strong);
    cursor: pointer;
    font-family: "FunkinOptions", sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-align: center;
    text-transform: uppercase;
  }

  .site-footer {
    display: grid;
    align-items: end;
  }

  .site-footer-content {
    position: relative;
    width: min(100%, 42rem);
    max-width: 42rem;
    padding-top: 1.25rem;
    text-align: center;
  }

  .site-footer-lineup {
    position: relative;
    z-index: 0;
    width: min(100%, 58rem);
    height: clamp(6rem, 18vw, 11rem);
    margin: 0 auto -0.25rem;
    background: var(--site-foreground);
    opacity: 0.28;
    mask: url("/assets/brand/og-character-lineup.webp") center / contain no-repeat;
    -webkit-mask: url("/assets/brand/og-character-lineup.webp") center / contain no-repeat;
    pointer-events: none;
    transform: translateY(0.5rem);
  }

  .site-footer h2,
  .site-footer-links,
  .site-footer-note {
    position: relative;
    z-index: 1;
  }

  .site-footer h2 {
    margin: 0;
    color: var(--site-accent);
    font-family: "FunkinOptions", sans-serif;
    font-size: clamp(2.75rem, 8vw, 5.5rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 0.84;
  }

  .site-footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1.25rem;
    margin-top: 1.25rem;
  }

  .site-footer-links a {
    color: var(--site-muted-strong);
    font-family: "FunkinOptions", sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 180ms ease;
  }

  .site-footer-links a:hover,
  .site-footer-links a:focus-visible {
    color: var(--site-accent);
  }

  .site-footer-links a:focus-visible {
    outline: 2px solid var(--site-accent);
    outline-offset: 0.35rem;
  }

  .site-footer-note {
    margin: 1rem 0 0;
    color: var(--site-muted);
    font-size: 0.75rem;
  }

  @media (max-width: 1100px) {
    .swiper-slide {
      padding: 1.5rem;
    }

    h1 {
      font-size: clamp(4rem, 22vw, 8rem);
    }

    .about-preview,
    .explore-preview,
    .support-preview {
      padding: 1.5rem;
    }

    .about-preview h2,
    .explore-preview h2,
    .support-preview h2 {
      font-size: clamp(3.5rem, 10vw, 6rem);
    }
  }

  @media (max-width: 800px) {
    .about-preview,
    .explore-preview,
    .support-preview {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: 1.5rem;
    }

    .about-illustration,
    .explore-illustration,
    .support-illustration {
      min-height: 0;
    }

    .about-illustration img,
    .explore-illustration img,
    .support-illustration img {
      height: var(--site-feature-visual-height-mobile);
    }

    .about-preview-content,
    .explore-content,
    .support-content {
      margin: 0 auto;
      text-align: center;
    }

    .about-preview-content p,
    .explore-content p,
    .support-content p {
      margin-inline: auto;
    }

    .about-preview .slide-navigation,
    .explore-preview .slide-navigation,
    .support-preview .slide-navigation {
      display: none;
    }
  }

</style>

<script>
  import Swiper from "swiper";
  import { Keyboard, Mousewheel } from "swiper/modules";
  import "swiper/css";

  const slideControls = document.querySelectorAll("[data-slide-direction]");
  const explorePickerButton = document.querySelector(".explore-picker-button");
  const swiper = new Swiper(".swiper", {
    modules: [Keyboard, Mousewheel],
    direction: "vertical",
    slidesPerView: 1,
    speed: 800,
    mousewheel: {
      forceToAxis: true,
      releaseOnEdges: true,
    },
    keyboard: { enabled: true },
  });

  slideControls.forEach((control) => {
    control.addEventListener("click", () => {
      if (!(control instanceof HTMLButtonElement) || control.disabled) return;

      if (control.dataset.slideDirection === "prev") {
        swiper.slidePrev();
      } else {
        swiper.slideNext();
      }
    });
  });

  explorePickerButton?.addEventListener("click", () => {
    document.querySelector<HTMLButtonElement>(".sidebar-button")?.click();
  });
</script>
