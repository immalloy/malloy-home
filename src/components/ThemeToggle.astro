<button class="theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false">
  <img class="theme-toggle-icon theme-toggle-moon" src="/assets/moon.png" alt="" aria-hidden="true" />
  <img class="theme-toggle-icon theme-toggle-sun" src="/assets/sun.png" alt="" aria-hidden="true" />
</button>

<style>
  .theme-toggle {
    position: fixed;
    z-index: 25;
    top: max(1rem, env(safe-area-inset-top));
    left: max(1rem, env(safe-area-inset-left));
    display: grid;
    width: 4.5rem;
    height: 4.5rem;
    border: 0;
    padding: 0.5rem;
    place-items: center;
    background: transparent;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-0.5rem) scale(0.9);
    transition: opacity 220ms ease, transform 220ms ease;
  }

  :global(html[data-sidebar-open="true"]) .theme-toggle {
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }

  .theme-toggle:hover {
    transform: scale(1.08);
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle,
    .theme-toggle-icon {
      transition: none;
    }
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--site-accent);
    outline-offset: 0.25rem;
  }

  .theme-toggle-icon {
    grid-area: 1 / 1;
    place-self: center;
    width: 3.25rem;
    height: 3.25rem;
    object-fit: contain;
    transition: opacity 150ms ease-out, transform 230ms cubic-bezier(0.34, 1.35, 0.64, 1);
  }

  .theme-toggle-moon {
    opacity: 0;
    transform: scale(0.75) rotate(-180deg);
  }

  .theme-toggle-sun {
    opacity: 1;
    transform: scale(1) rotate(0);
    filter: drop-shadow(2px 0 var(--site-foreground)) drop-shadow(-2px 0 var(--site-foreground)) drop-shadow(0 2px var(--site-foreground)) drop-shadow(0 -2px var(--site-foreground)) drop-shadow(1px 1px var(--site-foreground)) drop-shadow(-1px 1px var(--site-foreground)) drop-shadow(1px -1px var(--site-foreground)) drop-shadow(-1px -1px var(--site-foreground));
  }

  :global(html[data-theme="dark"]) .theme-toggle-moon {
    opacity: 1;
    transform: scale(1) rotate(0);
  }

  :global(html[data-theme="dark"]) .theme-toggle-sun {
    opacity: 0;
    transform: scale(0.75) rotate(180deg);
  }
</style>

<script is:inline>
  const themeToggle = document.querySelector(".theme-toggle");

  const updateThemeToggle = (theme) => {
    themeToggle?.setAttribute("aria-pressed", String(theme === "dark"));
    themeToggle?.setAttribute(
      "aria-label",
      theme === "dark" ? "Switch to light mode" : "Switch to dark mode",
    );
  };

  if (themeToggle) {
    const currentTheme = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
    updateThemeToggle(currentTheme);

    themeToggle.addEventListener("click", () => {
      const theme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = theme;
      document.documentElement.style.colorScheme = theme;
      updateThemeToggle(theme);

      try {
        window.localStorage.setItem("malloy-theme", theme);
      } catch {
        // Storage can be unavailable in strict privacy modes.
      }
    });
  }
</script>
