---
import { getLocale, localizedPath } from "../lib/i18n";

const { comics, locale: requestedLocale } = Astro.props;
const locale = getLocale(requestedLocale ?? Astro.currentLocale);
const comicNumber = (index) => String(index + 1).padStart(2, "0");
---

<main class="comics-archive" aria-labelledby="comics-archive-title">
  <h1 id="comics-archive-title">Comics</h1>

  <div class="comic-archive-list">
    {comics.map((comic, index) => (
      <a class="comic-archive-item" href={localizedPath(locale, `/comics/${index + 1}`)}>
        <div class="comic-archive-preview">
          <img src={comic.src} alt="" loading="lazy" />
        </div>
        <div class="comic-archive-copy">
          <h2>
            <span class="comic-archive-number">{comicNumber(index)}.</span>
            <span>{comic.title}</span>
          </h2>
          <p>{comic.description}</p>
        </div>
      </a>
    ))}
  </div>
</main>

<style>
  .comics-archive {
    max-width: 74rem;
    min-height: 100svh;
    margin: 0 auto;
    padding: clamp(3rem, 7vw, 6rem) clamp(1.25rem, 4vw, 3rem) 6rem;
    color: var(--site-foreground);
  }

  .comics-archive h1 {
    margin: 0 0 clamp(2rem, 5vw, 4rem);
    color: var(--site-accent);
    font-family: "FunkinOptions", sans-serif;
    font-size: clamp(4rem, 10vw, 8rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 0.82;
    text-align: center;
  }

  :global(html[data-theme="dark"]) .comics-archive h1 {
    filter: drop-shadow(2px 0 var(--site-foreground)) drop-shadow(-2px 0 var(--site-foreground)) drop-shadow(0 2px var(--site-foreground)) drop-shadow(0 -2px var(--site-foreground)) drop-shadow(1px 1px var(--site-foreground)) drop-shadow(-1px 1px var(--site-foreground)) drop-shadow(1px -1px var(--site-foreground)) drop-shadow(-1px -1px var(--site-foreground));
  }

  .comic-archive-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 32rem));
    justify-content: center;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .comic-archive-item {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 0;
    overflow: hidden;
    padding: 0;
    background: color-mix(in srgb, var(--site-accent) 7%, var(--site-background));
    color: var(--site-foreground);
    text-decoration: none;
    box-shadow: 0 0 0 rgb(0 0 0 / 0);
    transform: translateY(0);
    transition: background-color 220ms ease, color 220ms ease, box-shadow 220ms ease, transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .comic-archive-preview {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--site-foreground);
  }

  .comic-archive-preview img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left center;
    transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .comic-archive-copy {
    padding: 1rem 1.25rem 1.25rem;
    transform: translateX(0);
    transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .comic-archive-item h2 {
    display: flex;
    gap: 0.65rem;
    margin: 0;
    font-family: "FunkinOptions", sans-serif;
    font-size: clamp(1.1rem, 2.2vw, 1.55rem);
    font-weight: 400;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .comic-archive-number {
    color: var(--site-accent);
    flex: 0 0 auto;
    transition: color 220ms ease;
  }

  .comic-archive-item p {
    margin: 0.65rem 0 0;
    color: var(--site-muted-strong);
    font-size: 1rem;
    line-height: 1.35;
    transition: color 220ms ease;
  }

  .comic-archive-item:hover,
  .comic-archive-item:focus-visible {
    background: var(--site-accent);
    color: var(--site-background);
    box-shadow: 0 0.75rem 1.5rem rgb(0 0 0 / 0.18);
    transform: translateY(-0.35rem);
  }

  .comic-archive-item:hover .comic-archive-preview img,
  .comic-archive-item:focus-visible .comic-archive-preview img {
    transform: scale(1.05);
  }

  .comic-archive-item:hover .comic-archive-copy,
  .comic-archive-item:focus-visible .comic-archive-copy {
    transform: translateX(0.25rem);
  }

  .comic-archive-item:hover .comic-archive-number,
  .comic-archive-item:focus-visible .comic-archive-number,
  .comic-archive-item:hover p,
  .comic-archive-item:focus-visible p {
    color: var(--site-background);
  }

  .comic-archive-item:focus-visible {
    outline: 2px solid var(--site-accent);
    outline-offset: 0.25rem;
  }

  @media (max-width: 600px) {
  }
</style>
