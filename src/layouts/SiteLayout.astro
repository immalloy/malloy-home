---
import ThemeToggle from "../components/ThemeToggle.astro";

interface Props {
  title: string;
  description: string;
  noIndex?: boolean;
}

const { title, description, noIndex = false } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.url).href;
const socialImageUrl = new URL("/assets/og-image.png", Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7862792133185594" crossorigin="anonymous"></script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noIndex && <link rel="canonical" href={canonicalUrl} />}
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {!noIndex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="Welcome to my website!" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <script is:inline>
      (() => {
        let storedTheme = null;

        try {
          storedTheme = window.localStorage.getItem("malloy-theme");
        } catch {
          // Use the system preference when storage is unavailable.
        }

        const theme = storedTheme === "dark" || storedTheme === "light"
          ? storedTheme
          : window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";

        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
  </head>
  <body>
    <slot />
    <button class="sidebar-button" type="button" aria-controls="site-sidebar" aria-expanded="false" aria-label="Open site navigation">
      <canvas class="sidebar-sprite" width="250" height="421" aria-hidden="true"></canvas>
    </button>
    <button class="sidebar-backdrop" type="button" tabindex="-1" aria-label="Close site navigation" aria-hidden="true"></button>
    <ThemeToggle />
    <aside class="site-sidebar" id="site-sidebar" aria-label="Site navigation" aria-hidden="true" inert>
      <div class="sidebar-content">
        <nav aria-label="Site navigation">
          <a href="/"><span class="sidebar-link-icon sidebar-icon-home" aria-hidden="true"></span><span>Home</span></a>
          <a href="/about"><span class="sidebar-link-icon sidebar-icon-about" aria-hidden="true"></span><span>About</span></a>
          <a href="/projects"><span class="sidebar-link-icon sidebar-icon-projects" aria-hidden="true"></span><span>Projects</span></a>
          <a href="/blog"><span class="sidebar-link-icon sidebar-icon-blog" aria-hidden="true"></span><span>Blog</span></a>
          <a href="/comics"><span class="sidebar-link-icon sidebar-icon-comics" aria-hidden="true"></span><span>Comics</span></a>
          <a href="/guestbook"><span class="sidebar-link-icon sidebar-icon-guestbook" aria-hidden="true"></span><span>Guestbook</span></a>
        </nav>
      </div>
    </aside>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --site-background: #f7f5ef;
    --site-foreground: #1a1d24;
    --site-muted: #1a1d2480;
    --site-muted-strong: #1a1d24a6;
    --site-accent: #5b8cff;
    --sidebar-duration: 280ms;
    --sidebar-easing: cubic-bezier(0.22, 1, 0.36, 1);
    --site-sidebar-width: min(26rem, calc(100vw - 3.5rem));
    --site-picker-width: clamp(3rem, 5vw, 5.5rem);
    --site-picker-height: calc(var(--site-picker-width) * 1.684);
    --site-picker-cutoff-height: calc(var(--site-picker-height) - 0.4rem);
  }

  html[data-theme="dark"] {
    color-scheme: dark;
    --site-background: #1a1d24;
    --site-foreground: #f7f5ef;
    --site-muted: #f7f5ef80;
    --site-muted-strong: #f7f5efa6;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    min-height: 100%;
  }

  body {
    margin: 0;
    background-color: var(--site-background);
    color: var(--site-foreground);
    font-family: "FunkinLingLong", sans-serif;
    transition: background-color 220ms ease, color 220ms ease;
  }

  .sidebar-button {
    position: fixed;
    z-index: 40;
    top: 50%;
    right: env(safe-area-inset-right);
    display: block;
    width: var(--site-picker-width);
    aspect-ratio: 250 / 421;
    padding: 0;
    translate: 0 -50%;
    scale: 1;
    transform-origin: right center;
    border: 0;
    background: transparent;
    cursor: pointer;
    opacity: 0.55;
    transition: translate var(--sidebar-duration) var(--sidebar-easing), scale 180ms ease, opacity 180ms ease;
  }

  .sidebar-button:hover,
  .sidebar-button:focus-visible {
    opacity: 1;
    scale: 1.06;
  }

  .sidebar-button:active {
    scale: 0.96;
  }

  .sidebar-button:focus-visible {
    outline: 2px solid var(--site-foreground);
    outline-offset: 0.35rem;
  }

  .sidebar-sprite {
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .sidebar-backdrop {
    position: fixed;
    z-index: 20;
    inset: 0;
    border: 0;
    padding: 0;
    background: oklch(0 0 0 / 0.42);
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 260ms ease;
  }

  .site-sidebar {
    position: fixed;
    z-index: 30;
    inset-block: 0;
    right: 0;
    width: var(--site-sidebar-width);
    padding: max(1.5rem, env(safe-area-inset-top)) max(1.5rem, env(safe-area-inset-right)) max(1.5rem, env(safe-area-inset-bottom)) max(1.5rem, env(safe-area-inset-left));
    background: #000000;
    color: #CCCCCC;
    box-shadow: -2rem 0 4rem oklch(0 0 0 / 0.18);
    display: flex;
    flex-direction: column;
    opacity: 1;
    overflow: hidden;
    pointer-events: none;
    transform: translateX(100%);
    transition: transform var(--sidebar-duration) var(--sidebar-easing);
  }

  .site-sidebar::before {
    position: absolute;
    z-index: 0;
    inset-block: 0;
    inset-inline-start: 0;
    width: 5px;
    background:
      linear-gradient(#CCCCCC, #CCCCCC) left top / 100% calc(50% - var(--site-picker-cutoff-height) / 2) no-repeat,
      linear-gradient(#CCCCCC, #CCCCCC) left bottom / 100% calc(50% - var(--site-picker-cutoff-height) / 2) no-repeat;
    content: "";
    pointer-events: none;
  }

  .site-sidebar[aria-hidden="false"] {
    pointer-events: auto;
    transform: translateX(0);
  }

  .sidebar-content {
    display: flex;
    min-height: 0;
    flex: 1;
    flex-direction: column;
    gap: 2rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-block: 0.4rem;
    scrollbar-color: #ffffff transparent;
    scrollbar-width: thin;
  }

  .sidebar-content::-webkit-scrollbar {
    width: 0.45rem;
  }

  .sidebar-content::-webkit-scrollbar-track {
    background: transparent;
  }

  .sidebar-content::-webkit-scrollbar-thumb {
    background: #ffffff;
  }

  .site-sidebar nav {
    display: grid;
    gap: 0.75rem;
    margin-block: auto;
  }

  .site-sidebar nav a {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    border: 2px solid transparent;
    padding: 0.9rem 1rem;
    color: #CCCCCC;
    font-family: "FunkinOptions", sans-serif;
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .sidebar-link-icon {
    display: block;
    width: 1.65em;
    height: 1.65em;
    flex: 0 0 1.65em;
    background-color: currentColor;
    mask: var(--sidebar-icon) center / contain no-repeat;
    -webkit-mask: var(--sidebar-icon) center / contain no-repeat;
  }

  .sidebar-icon-home {
    --sidebar-icon: url("/assets/sidebar/home.png");
  }

  .sidebar-icon-about {
    --sidebar-icon: url("/assets/sidebar/about.png");
  }

  .sidebar-icon-projects {
    --sidebar-icon: url("/assets/sidebar/projects.png");
  }

  .sidebar-icon-blog {
    --sidebar-icon: url("/assets/sidebar/blog.png");
  }

  .sidebar-icon-comics {
    --sidebar-icon: url("/assets/sidebar/comics.png");
  }

  .sidebar-icon-guestbook {
    --sidebar-icon: url("/assets/sidebar/guestbook.png");
  }

  .site-sidebar nav a:hover,
  .site-sidebar nav a:focus-visible {
    background: #FFD84D;
    color: #000000;
    transform: translateX(-0.2rem);
  }

  .site-sidebar nav a:focus-visible {
    outline: 2px solid var(--site-foreground);
    outline-offset: 0.35rem;
  }

  html[data-sidebar-open="true"] {
    overflow: hidden;
  }

  html[data-sidebar-open="true"] .sidebar-backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  html[data-sidebar-open="true"] .sidebar-button {
    translate: calc(0.25rem + env(safe-area-inset-right) - var(--site-sidebar-width)) -50%;
  }

  html[data-sidebar-open="true"] .sidebar-button,
  html[data-sidebar-open="true"] .sidebar-button:hover,
  html[data-sidebar-open="true"] .sidebar-button:focus-visible,
  html[data-sidebar-open="true"] .sidebar-button:active {
    opacity: 1;
    scale: 1;
  }

</style>

<script>
  const sidebarButton = document.querySelector(".sidebar-button");
  const sidebar = document.querySelector("#site-sidebar");
  const sidebarBackdrop = document.querySelector(".sidebar-backdrop");
  const sidebarSprite = sidebarButton?.querySelector(".sidebar-sprite");
  const spriteContext = sidebarSprite instanceof HTMLCanvasElement ? sidebarSprite.getContext("2d") : null;
  const spriteImage = new Image();
  const pageContent = [...document.body.children].filter(
    (element) => !element.matches(".sidebar-button, .sidebar-backdrop, .theme-toggle, #site-sidebar"),
  );
  let lastFocusedElement = null;
  let spriteReady = false;
  let currentFrame = null;
  let spriteAnimations = {};
  let spriteFrameRequest = 0;
  let activeSpriteAnimation = null;
  let requestedSidebarOpen = false;
  let sidebarRequestId = 0;

  const setSpriteFrame = (frame) => {
    currentFrame = frame;
    if (!(sidebarSprite instanceof HTMLCanvasElement) || !spriteContext || !spriteReady) return;

    const { frame: sourceFrame, spriteSourceSize, sourceSize } = frame;
    const destinationX = 250 - sourceSize.w + spriteSourceSize.x;
    spriteContext.clearRect(0, 0, 250, 421);
    spriteContext.drawImage(
      spriteImage,
      sourceFrame.x,
      sourceFrame.y,
      sourceFrame.w,
      sourceFrame.h,
      destinationX,
      spriteSourceSize.y,
      spriteSourceSize.w,
      spriteSourceSize.h,
    );
  };

  const getSidebarDuration = () => {
    const rawDuration = getComputedStyle(document.documentElement)
      .getPropertyValue("--sidebar-duration")
      .trim();
    const duration = Number.parseFloat(rawDuration);

    if (!Number.isFinite(duration)) return 280;
    if (rawDuration.endsWith("ms")) return duration;
    if (rawDuration.endsWith("s")) return duration * 1000;
    return 280;
  };

  const cancelSpriteAnimation = () => {
    window.cancelAnimationFrame(spriteFrameRequest);
    spriteFrameRequest = 0;

    if (activeSpriteAnimation) {
      activeSpriteAnimation.resolve(false);
      activeSpriteAnimation = null;
    }
  };

  const spriteReadyPromise = Promise.all([
    new Promise((resolve) => {
      spriteImage.addEventListener("load", resolve, { once: true });
      spriteImage.src = "/assets/picker.png";
    }),
    fetch("/assets/picker.json").then((response) => {
      if (!response.ok) throw new Error("Could not load picker metadata.");
      return response.json();
    }),
  ]).then(([, atlas]) => {
    spriteAnimations = atlas.frames.reduce((animations, frame) => {
      const animationName = frame.filename.replace(/\d+$/, "");
      (animations[animationName] ??= []).push(frame);
      return animations;
    }, {});
    spriteReady = true;
    setSpriteFrame(spriteAnimations.idle[0]);
    return true;
  }).catch(() => false);

  const playSprite = async (animationName, loop = false) => {
    const ready = await spriteReadyPromise;
    if (!ready) return false;

    const frames = spriteAnimations[animationName];
    if (!frames?.length) return false;

    cancelSpriteAnimation();

    if (loop) {
      const animation = { resolve: () => undefined };
      activeSpriteAnimation = animation;
      const frameDuration = 110;
      const startedAt = performance.now();
      setSpriteFrame(frames[0]);

      const tick = (timestamp) => {
        if (activeSpriteAnimation !== animation) return;

        const elapsed = Math.max(0, timestamp - startedAt);
        setSpriteFrame(frames[Math.floor(elapsed / frameDuration) % frames.length]);
        spriteFrameRequest = window.requestAnimationFrame(tick);
      };

      spriteFrameRequest = window.requestAnimationFrame(tick);
      return true;
    }

    return new Promise((resolve) => {
      const animation = { resolve };
      activeSpriteAnimation = animation;
      const duration = getSidebarDuration();
      const startedAt = performance.now();
      setSpriteFrame(frames[0]);

      const finish = (completed) => {
        if (activeSpriteAnimation !== animation) return;

        activeSpriteAnimation = null;
        window.cancelAnimationFrame(spriteFrameRequest);
        spriteFrameRequest = 0;
        if (completed) setSpriteFrame(frames[frames.length - 1]);
        resolve(completed);
      };

      const tick = (timestamp) => {
        if (activeSpriteAnimation !== animation) return;

        const progress = Math.min(1, Math.max(0, (timestamp - startedAt) / duration));
        const frameIndex = Math.min(frames.length - 1, Math.floor(progress * frames.length));
        setSpriteFrame(frames[frameIndex]);

        if (progress >= 1) {
          finish(true);
          return;
        }

        spriteFrameRequest = window.requestAnimationFrame(tick);
      };

      spriteFrameRequest = window.requestAnimationFrame(tick);
    });
  };

  const waitForSidebarTransition = () => new Promise((resolve) => {
    if (!(sidebar instanceof HTMLElement)) {
      resolve();
      return;
    }

    let finished = false;
    const finish = () => {
      if (finished) return;
      finished = true;
      sidebar.removeEventListener("transitionend", onTransitionEnd);
      sidebar.removeEventListener("transitioncancel", finish);
      window.clearTimeout(fallbackTimer);
      resolve();
    };
    const onTransitionEnd = (event) => {
      if (event.target === sidebar && event.propertyName === "transform") finish();
    };
    const fallbackTimer = window.setTimeout(finish, getSidebarDuration() + 80);

    sidebar.addEventListener("transitionend", onTransitionEnd);
    sidebar.addEventListener("transitioncancel", finish);
  });

  const setSidebarOpen = (open) => {
    if (!(sidebarButton instanceof HTMLButtonElement) || !(sidebar instanceof HTMLElement)) return;

    if (open) lastFocusedElement = document.activeElement;

    sidebarButton.setAttribute("aria-expanded", String(open));
    sidebarButton.setAttribute("aria-label", open ? "Close site navigation" : "Open site navigation");
    sidebarButton.tabIndex = 0;
    sidebar.setAttribute("aria-hidden", String(!open));
    sidebar.inert = !open;
    sidebarBackdrop?.setAttribute("aria-hidden", String(!open));
    document.documentElement.dataset.sidebarOpen = String(open);

    pageContent.forEach((element) => {
      element.inert = open;
    });

    if (open) {
      sidebarButton.focus();
    } else if (lastFocusedElement instanceof HTMLElement) {
      lastFocusedElement.focus();
    } else {
      sidebarButton.focus();
    }
  };

  const animateSidebar = async (open) => {
    requestedSidebarOpen = open;
    const requestId = ++sidebarRequestId;
    await spriteReadyPromise;

    if (requestId !== sidebarRequestId || !(sidebarButton instanceof HTMLButtonElement)) return;
    if (sidebarButton.getAttribute("aria-expanded") === String(open)) return;

    setSidebarOpen(open);
    await Promise.all([
      playSprite(open ? "spin" : "spinclose"),
      waitForSidebarTransition(),
    ]);

    if (requestId === sidebarRequestId && sidebarButton.getAttribute("aria-expanded") === String(open)) {
      void playSprite(open ? "idleopen" : "idle", true);
    }
  };

  void playSprite("idle", true);

  sidebarButton?.addEventListener("click", () => {
    void animateSidebar(!requestedSidebarOpen);
  });
  sidebarBackdrop?.addEventListener("click", () => void animateSidebar(false));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && (requestedSidebarOpen || sidebarButton?.getAttribute("aria-expanded") === "true")) {
      void animateSidebar(false);
    }
  });
</script>
