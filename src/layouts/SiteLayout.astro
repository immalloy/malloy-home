---
interface Props {
  title: string;
  description: string;
  noIndex?: boolean;
}

const { title, description, noIndex = false } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.url).href;
const socialImageUrl = new URL("/assets/og-image.png", Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noIndex && <link rel="canonical" href={canonicalUrl} />}
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {!noIndex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="ImMalloy. Welcome to my Website!" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <script is:inline>
      (() => {
        let storedTheme = null;

        try {
          storedTheme = window.localStorage.getItem("malloy-theme");
        } catch {
          // Use the system preference when storage is unavailable.
        }

        const theme = storedTheme === "dark" || storedTheme === "light"
          ? storedTheme
          : window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";

        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --site-background: #f7f5ef;
    --site-foreground: #1a1d24;
    --site-muted: #1a1d2480;
    --site-muted-strong: #1a1d24a6;
    --site-accent: #5b8cff;
  }

  html[data-theme="dark"] {
    color-scheme: dark;
    --site-background: #1a1d24;
    --site-foreground: #f7f5ef;
    --site-muted: #f7f5ef80;
    --site-muted-strong: #f7f5efa6;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    min-height: 100%;
  }

  body {
    margin: 0;
    background-color: var(--site-background);
    color: var(--site-foreground);
    font-family: "FunkinLingLong", sans-serif;
    transition: background-color 220ms ease, color 220ms ease;
  }
</style>
